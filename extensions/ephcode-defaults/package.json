{
	"name": "ephcode-defaults",
	"displayName": "ephcode Defaults",
	"description": "Default configuration for ephcode",
	"version": "1.0.0",
	"publisher": "ephcode",
	"license": "MIT",
	"engines": {
		"vscode": "*"
	},
	"contributes": {
		"configurationDefaults": {
			"editor.minimap.enabled": false,
			"editor.renderWhitespace": "all",
			"editor.guides.indentation": false,
			"editor.renderLineHighlight": "none",
			"editor.overviewRulerBorder": false,
			"editor.hideCursorInOverviewRuler": true,
			"editor.occurrencesHighlight": "multiFile",
			"editor.matchBrackets": "never",
			"editor.glyphMargin": false,
			"editor.fontLigatures": true,
			"editor.formatOnSave": false,
			"editor.lightbulb.enabled": "off",
			"editor.linkedEditing": true,
			"editor.minimap.maxColumn": 100,
			"editor.minimap.renderCharacters": false,
			"editor.selectionHighlight": false,
			"editor.guides.highlightActiveBracketPair": false,
			"editor.bracketPairColorization.enabled": false,
			"editor.multiCursorModifier": "alt",
			"editor.accessibilitySupport": "off",
			"editor.scrollbar.horizontal": "visible",
			"editor.scrollbar.vertical": "visible",
			"editor.suggestSelection": "first",
			"editor.scrollbar.verticalScrollbarSize": 5,
			"editor.showFoldingControls": "mouseover",
			"editor.padding.top": 10,
			"editor.inlayHints.padding": true,
			"editor.inlayHints.enabled": "on",
			"editor.folding": true,
			"editor.foldingStrategy": "auto",
			"editor.cursorBlinking": "smooth",
			"editor.cursorSmoothCaretAnimation": "on",
			"editor.stickyScroll.enabled": true,
			"editor.stickyScroll.scrollWithEditor": false,
			"editor.smoothScrolling": true,
			"editor.inlineSuggest.syntaxHighlightingEnabled": true,
			"editor.rulers": [100],
			"editor.renderControlCharacters": false,
			"breadcrumbs.enabled": true,
			"breadcrumbs.filePath": "on",
			"breadcrumbs.symbolPath": "on",
			"explorer.compactFolders": false,
			"explorer.openEditors.visible": 0,
			"explorer.decorations.colors": false,
			"explorer.decorations.badges": true,
			"explorer.fileNesting.enabled": true,
			"explorer.fileNesting.expand": false,
			"explorer.autoReveal": true,
			"terminal.integrated.defaultLocation": "view",
			"terminal.integrated.gpuAcceleration": "on",
			"terminal.integrated.cursorStyle": "block",
			"terminal.integrated.tabs.enabled": true,
			"terminal.integrated.tabs.location": "right",
			"terminal.integrated.smoothScrolling": true,
			"terminal.integrated.hideOnStartup": "always",
			"terminal.integrated.suggest.enabled": true,
			"window.commandCenter": false,
			"window.nativeTabs": false,
			"window.titleBarStyle": "custom",
			"window.customTitleBarVisibility": "never",
			"workbench.editor.showIcons": true,
			"workbench.editor.editorActionsLocation": "default",
			"workbench.editor.showTabs": "multiple",
			"window.density.editorTabHeight": "default",
			"workbench.tree.indent": 16,
			"workbench.colorCustomizations": {
				"tab.activeBorder": "#0000"
			},
			"workbench.activityBar.location": "hidden",
			"workbench.startupEditor": "none",
			"workbench.colorTheme": "ephcode Dark Forest",
			"workbench.statusBar.visible": false,
			"workbench.sideBar.location": "right",
			"chat.commandCenter.enabled": false,
			"chat.editor.enabled": false,
			"github.copilot.enable": {
				"*": false,
				"plaintext": false,
				"markdown": false,
				"scminput": false
			},
			"workbench.secondarySideBar.defaultOpen": false,
			"git.autofetch": true,
			"git.openRepositoryInParentFolders": "never",
			"files.exclude": {
				"**/__init__.py": true,
				"**/__pycache__": true,
				"**/*.egg-*": true
			}
		}
	}
}
