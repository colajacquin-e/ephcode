	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#445a4dbb",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["string", "string.quoted", "string.template"],
			"settings": {
				"foreground": "#7a9680"
			}
		},
		{
			"scope": ["constant.numeric"],
			"settings": {
				"foreground": "#c4966a"
			}
		},
		{
			"scope": ["constant.language"],
			"settings": {
				"foreground": "#c47a6a"
			}
		},
		{
			"scope": ["constant.other", "variable.other.constant"],
			"settings": {
				"foreground": "#c4966a"
			}
		},
		{
			"scope": ["keyword", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical", "storage.type", "storage.modifier"],
			"settings": {
				"foreground": "#a07050"
			}
		},
		{
			"scope": ["keyword.operator", "keyword.operator.assignment", "keyword.operator.arithmetic", "keyword.operator.comparison"],
			"settings": {
				"foreground": "#8a9b8e"
			}
		},
		{
			"scope": ["punctuation", "punctuation.definition", "punctuation.separator", "punctuation.section"],
			"settings": {
				"foreground": "#6b7078"
			}
		},
		{
			"scope": ["variable", "variable.other"],
			"settings": {
				"foreground": "#c5cbc8"
			}
		},
		{
			"scope": ["variable.parameter"],
			"settings": {
				"foreground": "#b8a8c0"
			}
		},
		{
			"scope": ["variable.language"],
			"settings": {
				"foreground": "#c47a6a",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["entity.name.function", "meta.function-call.generic.python"],
			"settings": {
				"foreground": "#6baabe"
			}
		},
		{
			"scope": ["support.function", "support.function.builtin"],
			"settings": {
				"foreground": "#5a9aaa"
			}
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
			"settings": {
				"foreground": "#b5a882"
			}
		},
		{
			"scope": ["entity.other.inherited-class"],
			"settings": {
				"foreground": "#b5a882",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["entity.name.tag"],
			"settings": {
				"foreground": "#6baabe"
			}
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#b5a882",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"],
			"settings": {
				"foreground": "#9a8aaa",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["support.module", "meta.object-literal.key"],
			"settings": {
				"foreground": "#8a9b8e"
			}
		},
		{
			"scope": ["support.type.property-name"],
			"settings": {
				"foreground": "#6baabe"
			}
		},
		{
			"scope": ["variable.other.property", "meta.attribute.python"],
			"settings": {
				"foreground": "#8aaabe"
			}
		},
		{
			"scope": ["entity.name.namespace", "entity.name.module"],
			"settings": {
				"foreground": "#c5cbc8"
			}
		},
		{
			"scope": ["entity.name.import", "meta.import"],
			"settings": {
				"foreground": "#c5cbc8"
			}
		},
		{
			"scope": ["string.interpolated", "punctuation.definition.template-expression", "punctuation.section.embedded"],
			"settings": {
				"foreground": "#c47a6a"
			}
		},
		{
			"scope": ["markup.heading"],
			"settings": {
				"foreground": "#c4966a",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.bold"],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.italic"],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code"],
			"settings": {
				"foreground": "#7a9680"
			}
		},
		{
			"scope": ["markup.underline.link"],
			"settings": {
				"foreground": "#6baabe"
			}
		},
		{
			"scope": ["markup.inserted"],
			"settings": {
				"foreground": "#779e7f"
			}
		},
		{
			"scope": ["markup.deleted"],
			"settings": {
				"foreground": "#e05534"
			}
		},
		{
			"scope": ["markup.changed"],
			"settings": {
				"foreground": "#c4966a"
			}
		},
		{
			"scope": ["string.regexp"],
			"settings": {
				"foreground": "#5a9a8a"
			}
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": {
				"foreground": "#e05534"
			}
		},
		{
			"scope": ["meta.diff.header"],
			"settings": {
				"foreground": "#c4966a",
				"fontStyle": "bold"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"function": "#6baabe",
		"function.declaration": "#6baabe",
		"function.defaultLibrary": "#5a9aaa",
		"method": "#6baabe",
		"method.declaration": "#6baabe",
		"variable": "#c5cbc8",
		"variable.readonly": "#c4966a",
		"variable.defaultLibrary": "#c47a6a",
		"property": "#8aaabe",
		"property.readonly": "#8aaabe",
		"parameter": "#b8a8c0",
		"type": "#b5a882",
		"type.defaultLibrary": "#b5a882",
		"class": "#b5a882",
		"class.declaration": "#b5a882",
		"interface": "#b5a882",
		"enum": "#b5a882",
		"enumMember": "#c4966a",
		"namespace": "#c5cbc8",
		"decorator": "#9a8aaa",
		"macro": "#a07050",
		"selfKeyword": "#c47a6a",
		"clsKeyword": "#c47a6a"
	}
}
